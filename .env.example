# ============================================================
# LG U+ 요금 자동납부 - 환경변수 예시 파일
# 이 파일을 `.env`로 복사하고 실제 값으로 채우세요.
#   cp .env.example .env
# .env 파일은 절대 커밋하지 마세요 (.gitignore에 포함됨).
# ============================================================

# --- 카카오 로그인 ---
KAKAO_ID=your_kakao_id@example.com
KAKAO_PW=your_kakao_password

# --- 결제 카드 정보 ---
CARD_NUM=0000000000000000
CARD_NAME=홍길동
CARD_BIRTH=19900101
CARD_EXP=1229           # MMYY 형식
PAY_AMOUNT=5999         # 납부 금액 (원)

# --- Telegram Bot (결과 알림 + OTP 양방향 수신) ---
# @BotFather 로 봇 생성 → 토큰 발급
# @userinfobot 으로 chat_id 확인
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=000000000
